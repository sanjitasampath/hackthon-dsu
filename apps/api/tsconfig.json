{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@ecosphere/shared": ["../../modules/shared/src/index.ts"],
      "@ecosphere/energy": ["../../modules/energy/src/index.ts"],
      "@ecosphere/waste": ["../../modules/waste/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
